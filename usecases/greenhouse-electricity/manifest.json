{
  "manifest_version": "1.0",
  "use_case_id": "greenhouse-electricity",
  "description": "Lamp electricity per m² per day of real greenhouses (Autonomous Greenhouse Challenge, WUR): cucumber 2018 and tomato 2019-2020, 12 compartments. Tested on 2-week blocks held out of every compartment (a greenhouse with its own history); the report also gives the score for a compartment the model has never seen.",
  "data_source": {
    "adapter": "csv-file",
    "path": "data/greenhouse_days.csv"
  },
  "training": {
    "target": "electricity_kwh_m2",
    "task": "regression",
    "time_column": "date",
    "target_min": 0,
    "drop_columns": [
      "crop",
      "heat_mj_m2",
      "heat_week_ago_mj_m2",
      "lamp_hours",
      "lamp_power_w_m2"
    ],
    "units": {
      "heat_setpoint_c": "°C",
      "vent_setpoint_c": "°C",
      "energy_screen_pct": "%",
      "co2_setpoint_ppm": "ppm",
      "outside_temp_c": "°C",
      "outside_temp_min_c": "°C",
      "radiation_j_cm2": "J/cm²/day",
      "wind_ms": "m/s",
      "outside_rh_pct": "%",
      "electricity_kwh_m2": "kWh/m²",
      "rail_min_c": "°C",
      "grow_min_c": "°C",
      "lamp_kwh_m2": "kWh/m²/day"
    },
    "test_blocks": {
      "days": 14,
      "every": 5,
      "group": "greenhouse"
    },
    "baseline": {
      "column": "electricity_week_ago_kwh_m2",
      "label": "the same as a week ago",
      "use_as_input": false
    }
  },
  "model": {
    "runner": "onnx",
    "version": "latest",
    "algorithms": [
      "linear_regression"
    ]
  },
  "policy": {
    "contains_personal_data": false,
    "reject_unknown_fields": true,
    "log_feature_values": true
  },
  "scenario": {
    "levers": {
      "heat_setpoint_c": {
        "label": "Heating temperature",
        "unit": "°C",
        "min": 14,
        "max": 26,
        "step": 0.5
      },
      "lamp_kwh_m2": {
        "label": "Lamp use (hours x installed power)",
        "unit": "kWh/m²/day",
        "min": 0,
        "max": 3.5,
        "step": 0.1,
        "effects": {
          "electricity_kwh_m2": "increasing"
        }
      },
      "energy_screen_pct": {
        "label": "Energy screen (climate computer %)",
        "unit": "%",
        "min": 0,
        "max": 100,
        "step": 10
      },
      "vent_setpoint_c": {
        "label": "Ventilation temperature",
        "unit": "°C",
        "min": 17,
        "max": 30,
        "step": 0.5
      },
      "rail_min_c": {
        "label": "Minimum rail pipe temperature",
        "unit": "°C",
        "min": 0,
        "max": 40,
        "step": 5
      },
      "grow_min_c": {
        "label": "Minimum crop pipe temperature",
        "unit": "°C",
        "min": 0,
        "max": 60,
        "step": 5
      }
    },
    "outputs": {
      "electricity_kwh_m2": {
        "label": "Lamp electricity",
        "value_eur": -0.065
      }
    },
    "case_label": "greenhouse-days"
  }
}
