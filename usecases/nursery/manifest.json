{
  "manifest_version": "1.0",
  "use_case_id": "nursery",
  "description": "A potted-plant batch: weeks to harvest, plants sold, gas for heating and lamp electricity (synthetic nursery with a known cause-and-effect model, real KNMI weather 2016-2025).",
  "data_source": {
    "adapter": "csv-file",
    "path": "data/nursery_base.csv"
  },
  "joins": [
    {
      "name": "compartment",
      "source": {
        "adapter": "csv-file",
        "path": "data/compartments.csv"
      },
      "keys": {
        "compartment": "compartment"
      },
      "aggregate": {
        "area_m2": {
          "column": "area_m2",
          "op": "first"
        },
        "lamp_type": {
          "column": "lamp_type",
          "op": "first"
        },
        "u_value": {
          "column": "u_value",
          "op": "first"
        }
      }
    },
    {
      "name": "weather",
      "source": {
        "adapter": "csv-file",
        "path": "data/weather_rotterdam.csv"
      },
      "time": {
        "base": "start_date",
        "lookup": "date"
      },
      "window": {
        "start": {
          "offset": 0
        },
        "end": {
          "offset": 10,
          "unit": "weeks"
        }
      },
      "aggregate": {
        "outside_temp_avg_c": {
          "column": "temp_mean_c",
          "op": "mean",
          "round": 2
        },
        "radiation_avg_j_cm2": {
          "column": "radiation_j_cm2",
          "op": "mean",
          "round": 1
        }
      },
      "fallback": "climatology"
    }
  ],
  "training": {
    "time_column": "start_date",
    "drop_columns": [
      "batch_id",
      "compartment"
    ],
    "outputs": {
      "weeks_to_harvest": {
        "unit": "weeks",
        "target_min": 0,
        "algorithms": ["blend", "lightgbm"]
      },
      "plants_sold": {
        "unit": "plants",
        "target_min": 0,
        "algorithms": ["blend", "lightgbm"]
      },
      "gas_m3": {
        "unit": "m³",
        "target_min": 0
      },
      "electricity_kwh": {
        "unit": "kWh",
        "target_min": 0
      }
    },
    "units": {
      "temp_setpoint_c": "°C",
      "light_hours": "h/day",
      "co2_ppm": "ppm",
      "ec_ms_cm": "mS/cm",
      "plant_density_m2": "plants/m²",
      "area_m2": "m²",
      "u_value": "W/m²K",
      "gas_price_eur_m3": "€/m³",
      "outside_temp_avg_c": "°C",
      "radiation_avg_j_cm2": "J/cm²/day"
    }
  },
  "model": {
    "runner": "onnx",
    "version": "latest"
  },
  "policy": {
    "contains_personal_data": false,
    "reject_unknown_fields": true,
    "log_feature_values": true
  },
  "scenario": {
    "levers": {
      "temp_setpoint_c": {
        "label": "Greenhouse temperature",
        "unit": "°C",
        "min": 17,
        "max": 23,
        "step": 0.5
      },
      "light_hours": {
        "label": "Lamp hours",
        "unit": "h/day",
        "min": 0,
        "max": 18,
        "step": 0.5,
        "effects": {
          "gas_m3": "decreasing",
          "weeks_to_harvest": "decreasing",
          "electricity_kwh": "increasing"
        }
      },
      "co2_ppm": {
        "label": "CO₂ level",
        "unit": "ppm",
        "min": 400,
        "max": 1100,
        "step": 50,
        "effects": {
          "gas_m3": "decreasing",
          "weeks_to_harvest": "decreasing"
        }
      },
      "ec_ms_cm": {
        "label": "Fertiliser (EC)",
        "unit": "mS/cm",
        "min": 1.2,
        "max": 2.8,
        "step": 0.1
      },
      "plant_density_m2": {
        "label": "Plant density",
        "unit": "plants/m²",
        "min": 32,
        "max": 64,
        "step": 1,
        "effects": {
          "gas_m3": "decreasing",
          "weeks_to_harvest": "decreasing",
          "plants_sold": "increasing"
        }
      }
    },
    "outputs": {
      "weeks_to_harvest": {
        "label": "Weeks to harvest"
      },
      "plants_sold": {
        "label": "Plants sold",
        "value_eur": 2.1
      },
      "gas_m3": {
        "label": "Gas use",
        "price_from": "gas_price_eur_m3",
        "is_cost": true
      },
      "electricity_kwh": {
        "label": "Lamp electricity",
        "value_eur": -0.12
      }
    },
    "case_label": "batches"
  },
  "aliases": {
    "nursery-gas": "gas_m3",
    "nursery-harvest-weeks": "weeks_to_harvest",
    "nursery-plants-sold": "plants_sold",
    "nursery-electricity": "electricity_kwh"
  }
}
